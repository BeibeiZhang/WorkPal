{
  "rewrites": [
    { "source": "/api/connectors/:id/:action", "destination": "/api/connectors?id=:id&action=:action" },
    { "source": "/api/artifacts/latest",     "destination": "/api/artifacts?endpoint=latest" },
    { "source": "/api/artifacts/generate",   "destination": "/api/artifacts?endpoint=generate" },
    { "source": "/api/artifacts/cron-sweep", "destination": "/api/artifacts?endpoint=cron-sweep" },
    { "source": "/api/artifacts/:slug",      "destination": "/api/artifacts?endpoint=slug&slug=:slug" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
