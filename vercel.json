{
  "rewrites": [
    { "source": "/api/chats/bulk-upsert",     "destination": "/api/chats?endpoint=bulk-upsert" },
    { "source": "/api/chats/:id",             "destination": "/api/chats?id=:id" },
    { "source": "/api/projects/bulk-upsert",  "destination": "/api/projects?endpoint=bulk-upsert" },
    { "source": "/api/projects/:id",          "destination": "/api/projects?id=:id" },
    { "source": "/api/memories/verify",       "destination": "/api/memories?endpoint=verify" },
    { "source": "/api/memories/:id",          "destination": "/api/memories?id=:id" },
    { "source": "/api/connectors/:id/:action", "destination": "/api/connectors?id=:id&action=:action" },
    { "source": "/api/artifacts/latest",     "destination": "/api/artifacts?endpoint=latest" },
    { "source": "/api/artifacts/generate",   "destination": "/api/artifacts?endpoint=generate" },
    { "source": "/api/artifacts/cron-sweep", "destination": "/api/artifacts?endpoint=cron-sweep" },
    { "source": "/api/artifacts/:slug",      "destination": "/api/artifacts?endpoint=slug&slug=:slug" },
    { "source": "/api/usage/log",            "destination": "/api/usage?endpoint=log" },
    { "source": "/api/search-images",        "destination": "/api/search?kind=images" },
    { "source": "/api/search-videos",        "destination": "/api/search?kind=videos" },
    { "source": "/api/search-web",           "destination": "/api/search?kind=web" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/artifacts/cron-sweep", "schedule": "0 3 * * 5" }
  ]
}
